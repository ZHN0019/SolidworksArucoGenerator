<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <SolidWorksInteropPath Condition="'$(SolidWorksInteropPath)' == ''">$(SOLIDWORKS_INTEROP_PATH)</SolidWorksInteropPath>
    <SolidWorksInteropPath Condition="'$(SolidWorksInteropPath)' == ''">$(ProgramFiles)\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SolidWorksInteropPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArucoSolidWorksAddin\ArucoSolidWorksAddin.csproj" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksInteropPath)\SolidWorks.Interop.sldworks.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksInteropPath)\SolidWorks.Interop.swconst.dll</HintPath>
      <Private>true</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
